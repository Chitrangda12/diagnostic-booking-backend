PORT=3000

# Main database (used by npm start / npm run dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diagnostic_booking

# Separate database used ONLY by `npm test` (tests wipe all tables in it!)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diagnostic_booking_test

# Use a long random string in real life
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# The payment "gateway" must send this in the x-webhook-secret header
WEBHOOK_SECRET=change-me-webhook-secret
